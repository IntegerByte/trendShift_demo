# ==========================================================================
# TrendShift React SPA — Apache configuration (applies to the built `dist/`
# output; Vite copies everything in public/ to the root of dist/ as-is).
# Every directive is <IfModule>-guarded so it's a no-op instead of a 500 if
# a module isn't loaded on the host.
# ==========================================================================

# ---- SPA fallback: let React Router own client-side routes -----------------
# Deep links (e.g. /contact) and hard refreshes on them must still work.
# Real files/directories are served as-is; anything else falls back to
# index.html so React Router can render the matching route client-side.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# ---- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

ServerSignature Off
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---- Performance: compression ---------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ---- Performance: caching ---------------------------------------------------
# Vite fingerprints built JS/CSS/asset filenames (e.g. index-a1b2c3.js), so
# those can be cached "forever" — a content change always ships a new URL.
# index.html (and any other top-level HTML) must always revalidate.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
